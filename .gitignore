# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/*.egg-info/
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.ipynb_checkpoints/

# -----------------------------------------------------------------------------
# Données générées (scraping, exports, cache)
# -----------------------------------------------------------------------------
scraper/output/
scraper/.cache/
data/
