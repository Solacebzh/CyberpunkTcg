.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini
*.swp
*.swo
*~

.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.code-workspace
.*.swp

# -----------------------------------------------------------------------------
# Secrets & configuration locale (ne JAMAIS committer)
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
**/application-local.yml
**/application-local.yaml
*.pem
*.jks
*.p12

# -----------------------------------------------------------------------------
# Java / Maven / Gradle
# -----------------------------------------------------------------------------
target/
build/
out/
!.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*
.gradle/
*.log.lck

# -----------------------------------------------------------------------------
# Node / Vue / Vite / Tailwind
# -----------------------------------------------------------------------------
node_modules/
.pnpm-store/
dist/
dist-ssr/
.vite/
.vite-inspect/
*.tsbuildinfo
.eslintcache
.stylelintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
coverage/
*.local

# -----------------------------------------------------------------------------
