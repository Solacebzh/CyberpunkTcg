# =============================================================================
# Variables d'environnement — copier en .env puis adapter :  cp .env.example .env
# Ce fichier est lu par docker compose (PostgreSQL) et par le backend Spring Boot.
# =============================================================================

# --- PostgreSQL (docker-compose) ---
POSTGRES_DB=cyberpunk_tcg
POSTGRES_USER=cyberpunk
POSTGRES_PASSWORD=cyberpunk
POSTGRES_PORT=5432
ADMINER_PORT=8081

# --- Backend Spring Boot ---
SERVER_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/cyberpunk_tcg
DB_USERNAME=cyberpunk
DB_PASSWORD=cyberpunk
# update = pratique en dev, validate = à utiliser en production (migrations à venir)
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
LOG_LEVEL_APP=DEBUG
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend Vite ---
# Laisser vide pour utiliser les URLs relatives (/api, /ws) et le proxy de dev Vite.
VITE_API_BASE_URL=
VITE_WS_URL=
