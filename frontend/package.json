{
  "name": "cyberpunk-tcg-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Client web du Cyberpunk TCG Online (Vue 3 + TypeScript + Vite)",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build --force",
    "mock:ws": "node tools/mock-server.mjs",
    "test:unit": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@stomp/stompjs": "^7.3.0",
    "gsap": "^3.15.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.0",
    "vue-tsc": "^2.2.12",
    "ws": "^8.21.3"
  }
}
