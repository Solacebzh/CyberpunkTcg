# =============================================================================
# Frontend — variables d'environnement Vite (copier en .env.local si besoin)
# Toute variable exposée au navigateur doit être préfixée par VITE_.
# =============================================================================

# Base des URLs d'API. Laisser vide = URLs relatives (/api) → passe par le proxy Vite en dev.
# Exemple pour un backend distant : VITE_API_BASE_URL=https://api.mon-domaine.dev
VITE_API_BASE_URL=

# URL absolue du WebSocket STOMP. Laisser vide = wss://<origine courante>/ws
# Exemple : VITE_WS_URL=wss://api.mon-domaine.dev/ws
VITE_WS_URL=

# Cible du proxy de développement (lu côté serveur Vite uniquement)
VITE_DEV_API_TARGET=http://localhost:8080
